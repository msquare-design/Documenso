# Copy to .env on the server (/opt/documenso/.env) and fill in real values.
# NEVER commit the real .env — this repo is public.
# Generate secrets with: openssl rand -hex 32

NEXT_PUBLIC_WEBAPP_URL=https://sign.msquarebh.com
NEXTAUTH_SECRET=
NEXT_PRIVATE_ENCRYPTION_KEY=
NEXT_PRIVATE_ENCRYPTION_SECONDARY_KEY=

POSTGRES_USER=documenso
POSTGRES_PASSWORD=
POSTGRES_DB=documenso
NEXT_PRIVATE_DATABASE_URL=postgres://documenso:<POSTGRES_PASSWORD>@database:5432/documenso
NEXT_PRIVATE_DIRECT_DATABASE_URL=postgres://documenso:<POSTGRES_PASSWORD>@database:5432/documenso

NEXT_PRIVATE_SMTP_TRANSPORT=smtp-auth
NEXT_PRIVATE_SMTP_HOST=smtp.hostinger.com
NEXT_PRIVATE_SMTP_PORT=465
NEXT_PRIVATE_SMTP_SECURE=true
NEXT_PRIVATE_SMTP_USERNAME=sign@msquarebh.com
NEXT_PRIVATE_SMTP_PASSWORD=
NEXT_PRIVATE_SMTP_FROM_NAME="M Square"
NEXT_PRIVATE_SMTP_FROM_ADDRESS=sign@msquarebh.com

# Passphrase of cert.p12 (the signing certificate — keep it off GitHub too)
NEXT_PRIVATE_SIGNING_PASSPHRASE=

NEXT_PRIVATE_ALLOWED_SIGNUP_DOMAINS=msquarebh.com
# Set to true once your admin account exists
NEXT_PUBLIC_DISABLE_SIGNUP=
